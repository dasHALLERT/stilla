{
  "appId": "me.getstilla.app",
  "appName": "stilla",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#58d5c9"
  },
  "plugins": {
    "SplashScreen": {
      "backgroundColor": "#58d5c9",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}